# ============================================================
# SIGA - Environment Variables Example
# Copy this file to .env and adjust values
# ============================================================

# Database Configuration
DB_NAME=siga_db
DB_USER=siga_admin
DB_PASSWORD=your_secure_password
DB_HOST=siga-db
DB_PORT=5432

# pgAdmin Configuration
PGADMIN_EMAIL=admin@siga.cl
PGADMIN_PASSWORD=admin_password

# Eureka Configuration
EUREKA_URL=http://siga-eureka:8761/eureka/

# Service Ports
AUTH_PORT=8081
INVENTORY_PORT=8082
SALES_PORT=8083
BILLING_PORT=8084
AGENT_PORT=8000
GATEWAY_PORT=8080
