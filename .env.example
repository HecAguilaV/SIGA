# ============================================================
# SIGA - Environment Configuration Template (12-Factor App)
# 
# INSTRUCCIONES:
# 1. Copia este archivo y renómbralo a .env
# 2. Reemplaza los valores entre < > con tus credenciales reales
# 3. Los valores por defecto (puertos, usuarios DB) están listos 
#    para usarse "out-of-the-box" en un entorno local (Desarrollo).
# ============================================================

# --- 1. SECRETS & 3RD PARTY APIs (¡Obligatorio cambiar!) ---

# AI Agent (Google Gemini)
GEMINI_API_KEY=<your-model-api-key>
GEMINI_MODEL_ID=nombre-del-modelo-a-elección

# Security - REQUERIDO: Generar un secreto aleatorio de 256+ bits
# Ejemplo en terminal: openssl rand -hex 32
JWT_SECRET=<your-256-bit-secret>

# Ops & Observability (ContainerFlow)
OPS_AUTH_TOKEN=<your-containerflow-token>

# Mail (Servicio SMTP para verificación)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=<your_email@gmail.com>
SPRING_MAIL_PASSWORD=<your_app_password>


# --- 2. LOCAL INFRASTRUCTURE DEFAULTS (Seguros para desarrollo local) ---

# Puertos y Redes Core
DB_HOST=siga-db
DB_PORT=5432
REDIS_PORT=6379
GATEWAY_PORT=8080
EUREKA_URL=http://siga-eureka:8761/eureka/
KAFKA_PORT=9092
KAFKA_UI_PORT=8085
OPS_PORT=9470

# Consola de Administración DB (pgAdmin)
PGADMIN_EMAIL=admin@siga.local
PGADMIN_PASSWORD=siga_local_dev

# Base de Datos PostgreSQL (Superusuario)
POSTGRES_DB=siga_master_db
POSTGRES_USER=siga_admin
POSTGRES_PASSWORD=siga_local_dev

# Microservicios (Aislamiento de Bases de Datos)
AUTH_DB_NAME=siga_auth
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=siga_local_dev
AUTH_PORT=8081

INVENTORY_DB_NAME=siga_inventory
INVENTORY_DB_USER=inventory_user
INVENTORY_DB_PASSWORD=siga_local_dev
INVENTORY_PORT=8082

SALES_DB_NAME=siga_sales
SALES_DB_USER=sales_user
SALES_DB_PASSWORD=siga_local_dev
SALES_PORT=8083

BILLING_DB_NAME=siga_billing
BILLING_DB_USER=billing_user
BILLING_DB_PASSWORD=siga_local_dev
BILLING_PORT=8084

AGENT_DB_NAME=siga_agent
AGENT_DB_USER=agent_user
AGENT_DB_PASSWORD=siga_local_dev
AGENT_PORT=8000

NOTIFICATION_DB_NAME=siga_notification
NOTIFICATION_DB_USER=notification_user
NOTIFICATION_DB_PASSWORD=siga_local_dev
NOTIFICATION_PORT=8086
