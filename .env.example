# ============================================================
# SIGA - Environment Configuration Template
# Copia este archivo como .env y completa los valores reales.
# ============================================================

# --- GLOBAL INFRASTRUCTURE ---
DB_HOST=siga-db
DB_PORT=5432
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change_me
EUREKA_URL=http://siga-eureka:8761/eureka/
KAFKA_PORT=9092
KAFKA_UI_PORT=8085

# --- POSTGRES SUPERUSER (Root) ---
POSTGRES_DB=siga_master_db
POSTGRES_USER=siga_admin
POSTGRES_PASSWORD=change_me

# --- MICROSERVICES DATABASES (Independent) ---

# Auth Service
AUTH_DB_NAME=siga_auth
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=change_me
AUTH_PORT=8081

# Inventory Service
INVENTORY_DB_NAME=siga_inventory
INVENTORY_DB_USER=inventory_user
INVENTORY_DB_PASSWORD=change_me
INVENTORY_PORT=8082

# Sales Service
SALES_DB_NAME=siga_sales
SALES_DB_USER=sales_user
SALES_DB_PASSWORD=change_me
SALES_PORT=8083

# Billing/Commercial Service
BILLING_DB_NAME=siga_billing
BILLING_DB_USER=billing_user
BILLING_DB_PASSWORD=change_me
BILLING_PORT=8084

# AI Agent Service
AGENT_DB_NAME=siga_agent
AGENT_DB_USER=agent_user
AGENT_DB_PASSWORD=change_me
AGENT_PORT=8000

# Gateway
GATEWAY_PORT=8080

# Security - CAMBIAR en producción
JWT_SECRET=change_me_to_a_long_random_secret

# Mail (para verificación de email)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_app_password
